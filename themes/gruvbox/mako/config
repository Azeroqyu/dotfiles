# Take a look at the mako manpage with the command:
#   man 5 mako
# To view all configuration options.

font=IosevkaNerdFont
format=<b>%a ⏵</b> %s\n%b
sort=-time
output=DP-2
layer=overlay
anchor=top-right
background-color=#282828c0
width=300
height=110
margin=5
padding=0,5,10
border-color=#98871a
border-radius=5
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

[urgency=normal]
border-color=#98871a
[urgency=high]
border-color=#8839ef
default-timeout=0

